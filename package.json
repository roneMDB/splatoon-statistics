{
  "name": "splatoon-statistics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Recupere les matchs Splatoon 3 d'une session de club depuis stat.ink",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch": "tsx src/cli.ts",
    "app": "npm run app:build && electron .",
    "app:build": "tsc -p tsconfig.electron.json && node -e \"require('fs').cpSync('src/electron/renderer','dist-electron/electron/renderer',{recursive:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "electron": "^44.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
