{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // Le rendu n'est pas transpile : renderer.js et markdown.js sont copies tels
    // quels. `allowJs` laisse TypeScript inferer leurs types pour les tests qui
    // les importent, sans les verifier eux-memes (`checkJs` reste desactive).
    "allowJs": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "tests",
    "scripts"
  ],
  "exclude": [
    "src/electron/preload.cts"
  ]
}
