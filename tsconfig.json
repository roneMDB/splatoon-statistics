{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // Le rendu n'est pas transpile : ses modules .js sont copies tels quels.
    // `allowJs` laisse TypeScript lire leurs types JSDoc pour les tests qui les
    // importent ; c'est `tsconfig.renderer.json`, avec le DOM, qui les verifie.
    "allowJs": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "tests",
    "scripts"
  ],
  "exclude": [
    "src/electron/preload.cts"
  ]
}
